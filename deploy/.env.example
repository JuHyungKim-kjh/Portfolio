# 이 파일을 .env 로 복사해 채운다.
#
#   cp .env.example .env && vi .env
#
# ★ 비밀정보가 없다 — 이 프로젝트는 DB 도 외부 API 키도 쓰지 않는다.
#   그래서 담다와 달리 .env 관리가 사실상 ECR_IMAGE 한 줄이다.

# 띄울 이미지. build-and-push.sh 나 GitHub Actions 가 주소를 찍어 준다.
# ⚠ latest 대신 커밋 해시 태그를 넣어 두는 편이 낫다 — 지금 무엇이 떠 있는지 알 수 있다.
ECR_IMAGE=<AWS계정번호>.dkr.ecr.ap-northeast-2.amazonaws.com/portfolio:latest

AWS_REGION=ap-northeast-2

# (선택) 화면의 연락처를 바꾸고 싶을 때만 주석을 푼다.
# 비워 두거나 지우면 application.yaml 의 기본값이 쓰인다.
#OWNER_EMAIL=hound9844@gmail.com
#OWNER_GITHUB=https://github.com/
